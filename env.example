# Football Prophet - Environment Variables

# football-data.org API (free tier: 10 req/min)
FOOTBALL_DATA_API_KEY=your_key_here

# API-Football (RapidAPI)
API_FOOTBALL_KEY=your_rapidapi_key_here

# The Odds API
ODDS_API_KEY=your_odds_api_key_here

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Database
DATABASE_URL=sqlite:///football_prophet.db

# General
LOG_LEVEL=INFO
PREDICTION_CONFIDENCE_MIN=0.55
VALUE_BET_EDGE_MIN=0.05
BANKROLL=1000.0
